<% content_for :title, "Shared sheet · #{@character.name.presence || 'character'}" %>

<div class="page-shell sheet-shell">
  <div class="shared-banner"><span class="shared-banner-mark">↗</span><div><strong>Read-only shared sheet</strong><span><%= @share.campaign.name %> · ownership stays with the player</span></div></div>
  <header class="sheet-header"><div class="sheet-title-block"><p class="eyebrow">Nimble character sheet</p><div class="sheet-title-row"><div class="avatar avatar-large avatar-<%= @character.id.to_i % 5 %>"><%= (@character.name.presence || "?")[0, 2].upcase %></div><div><h1><%= @character.name.presence || "Untitled hero" %></h1><p class="sheet-subtitle"><%= [ @character.character_class&.name || @character.nimble_class, @character.ancestry&.name || @character.race, "Level #{@character.level || '—'}" ].compact.join(" · ") %></p></div></div></div><span class="badge badge-playable">Read-only</span></header>
  <section class="vitals-grid"><div class="vital-card vital-card-hp"><span class="vital-label">Current HP</span><strong><%= @character.trait_set&.current_hp || "—" %><small> / <%= @character.trait_set&.max_hp || "—" %></small></strong><span class="vital-foot">Temp <%= @character.trait_set&.temp_hp || 0 %></span></div><div class="vital-card"><span class="vital-label">Armor</span><strong><%= @character.trait_set&.armor || "—" %></strong><span class="vital-foot">Unarmored</span></div><div class="vital-card"><span class="vital-label">Initiative</span><strong><%= signed_value(@character.trait_set&.initiative) if @character.trait_set %></strong><span class="vital-foot">DEX + ancestry</span></div><div class="vital-card"><span class="vital-label">Save DC</span><strong><%= @character.trait_set&.save_dc || "—" %></strong><span class="vital-foot">10 + KEY</span></div><div class="vital-card"><span class="vital-label">Mana</span><strong><%= @character.trait_set&.current_mana || "—" %><small><%= " / #{@character.trait_set.max_mana}" if @character.trait_set&.max_mana %></small></strong><span class="vital-foot">Safe Rest recharge</span></div><div class="vital-card"><span class="vital-label">Speed</span><strong><%= @character.trait_set&.speed || "—" %></strong><span class="vital-foot">spaces</span></div><div class="vital-card"><span class="vital-label">Wounds</span><strong><%= @character.trait_set&.current_wounds || "—" %><small> / <%= @character.trait_set&.max_wounds || "—" %></small></strong><span class="vital-foot">Hit Dice <%= @character.trait_set&.current_hit_dice || "—" %>/<%= @character.trait_set&.max_hit_dice || "—" %></span></div></section>
  <div class="sheet-grid"><div class="sheet-main-column"><section class="panel sheet-panel"><div class="panel-heading compact"><div><p class="eyebrow">Abilities</p><h2>Stats & skills</h2></div><span class="rules-context"><span class="context-dot"></span><%= @character.rules_context_label %></span></div><div class="sheet-stat-grid"><% Character::STAT_NAMES.each do |stat| %><div class="sheet-stat"><span><%= stat_display_name(stat) %></span><strong><%= signed_value(@character.stat_value(stat)) %></strong><small><%= @character.character_class&.key_stats&.include?(stat) ? "Key" : "Secondary" %></small></div><% end %></div><div class="sheet-skill-grid"><% Character::SKILL_NAMES.each do |skill| %><div class="sheet-skill"><span><%= skill_display_name(skill) %></span><strong><%= signed_value(@character.skill_value(skill)) %></strong></div><% end %></div></section><section class="panel sheet-panel"><div class="panel-heading compact"><div><p class="eyebrow">Origin</p><h2>Rules context</h2></div></div><div class="origin-grid"><div class="origin-card"><span class="origin-label">Class</span><strong><%= @character.character_class&.name || @character.nimble_class || "Not chosen" %></strong><p><%= @character.character_class ? "#{@character.character_class.key_stats.map { |stat| stat_display_name(stat) }.join(' + ')} Key Stats · #{@character.character_class.hit_die}" : "" %></p></div><div class="origin-card"><span class="origin-label">Ancestry</span><strong><%= @character.ancestry&.name || @character.race || "Not chosen" %></strong><p><%= @character.ancestry&.trait_summary %></p></div><div class="origin-card"><span class="origin-label">Background</span><strong><%= @character.background&.name || @character.legacy_background_text || "Not chosen" %></strong><p><%= @character.background&.description %></p></div><div class="origin-card"><span class="origin-label">Languages</span><strong><%= @character.languages.presence || "Common" %></strong><p>Common plus INT and ancestry grants.</p></div></div></section></div><aside class="sheet-side-column"><section class="panel"><div class="panel-heading compact"><div><p class="eyebrow">Magic</p><h2>Spells</h2></div></div><div class="spell-chips"><% @character.spells.order(:tier, :name).each do |spell| %><span class="spell-chip <%= color_from_spell_school(spell.school) %>"><%= spell.name %></span><% end %><% if @character.spells.empty? %><span class="muted">No spells on this sheet.</span><% end %></div></section><section class="panel"><p class="eyebrow">Notes</p><h2>At a glance</h2><p class="muted"><%= @character.description.presence || "No character description has been added." %></p><% if @character.conditions.present? %><p><strong>Conditions:</strong> <%= @character.conditions %></p><% end %><% if @character.game_notes.present? %><p><strong>Session notes:</strong> <%= @character.game_notes %></p><% end %></section></aside></div>
</div>
