<% if @story_subclass_changes.any? || (@can_approve_story_subclass && @story_subclass_options.any?) %>
  <section class="panel story-subclass-panel">
    <div class="panel-heading compact">
      <div><p class="eyebrow">Story milestone</p><h2>Subclass changes</h2></div>
      <span class="mini-label">GM-approved · audited</span>
    </div>
    <% if @can_approve_story_subclass && @story_subclass_options.any? %>
      <p class="muted">This is the only edit available to a GM on a shared sheet. It replaces the current subclass; the story note and rules source are recorded with the change.</p>
      <%= form_with scope: :story_subclass_change, url: shared_story_subclass_changes_path(@share.share_token), class: "story-subclass-form" do |form| %>
        <%= form.hidden_field :current_subclass, value: @character.subclass_name %>
        <div class="field">
          <%= form.label :to_subclass, "Story-based replacement" %>
          <%= form.select :to_subclass, @story_subclass_options.map { |subclass| [ subclass, subclass ] }, { include_blank: "Choose a story subclass" }, class: "choice-select", required: true %>
        </div>
        <div class="field">
          <%= form.label :story_note, "Why does the story call for this change?" %>
          <%= form.text_area :story_note, rows: 3, maxlength: StorySubclassChangeService::MAX_STORY_NOTE_LENGTH, placeholder: "Record the story moment and why this subclass replaces the current path…", class: "choice-textarea", required: true %>
          <% story_subclass_rule = @character.character_class.story_based_subclass_rule(@story_subclass_options.first) %>
          <span class="field-hint">Required audit note · up to <%= StorySubclassChangeService::MAX_STORY_NOTE_LENGTH %> characters · “<%= story_subclass_rule.fetch("source_quote") %>” (<%= story_subclass_rule.fetch("source_ref") %>)</span>
        </div>
        <% if @story_subclass_spell_choice_pools.any? %>
          <fieldset class="field feature-choice-field">
            <legend>Record choices granted through level <%= @character.level %></legend>
            <p class="field-hint">The replacement also grants these source-defined spell choices. Every choice already earned by this character must be recorded with the story change.</p>
            <% @story_subclass_spell_choice_pools.each do |pool| %>
              <% field_name = "story_subclass_change[spell_choices][#{pool.fetch('name')}][#{pool.fetch('level')}]" %>
              <% selected_spell = pool.fetch("selected").first %>
              <div class="field">
                <%= label_tag field_name, "Level #{pool.fetch('level')} · #{pool.fetch('name')}" %>
                <%= select_tag field_name, options_for_select(pool.fetch("options").map { |option| [ option, option ] }, selected_spell), include_blank: "Choose a spell", required: true, class: "choice-select" %>
                <span class="field-hint"><%= pool.fetch("source_quote") %> (<%= pool.fetch("source_ref") %>)</span>
              </div>
            <% end %>
          </fieldset>
        <% end %>
        <% if @story_subclass_companion_rule.present? %>
          <fieldset class="field feature-choice-field">
            <legend>Beastmaster companion</legend>
            <div class="field">
              <%= label_tag "story_subclass_change[companion_size]", "Animal size" %>
              <% size_options = @story_subclass_companion_rule.fetch("sizes").map do |size|
                minimum_level = @story_subclass_companion_rule.fetch("minimum_level_by_size", {}).fetch(size, 1).to_i
                [ size, size, { disabled: @character.level.to_i < minimum_level } ]
              end %>
              <%= select_tag "story_subclass_change[companion_size]", options_for_select(size_options), include_blank: "Choose a size", required: true, class: "choice-select" %>
            </div>
            <div class="field">
              <%= label_tag "story_subclass_change[companion_name]", "Companion animal" %>
              <%= text_field_tag "story_subclass_change[companion_name]", nil, maxlength: @story_subclass_companion_rule.fetch("name_max_length"), placeholder: "For example, a hawk named Ember", required: true, class: "choice-input" %>
            </div>
            <span class="field-hint"><%= @story_subclass_companion_rule.fetch("source_quote") %> <%= @story_subclass_companion_rule.fetch("behavior_quote") %> Medium and Large companions require level 3. (<%= @story_subclass_companion_rule.fetch("source_ref") %>)</span>
          </fieldset>
        <% end %>
        <% if @story_subclass_feature_choice_pools.any? %>
          <fieldset class="field feature-choice-field">
            <legend>Reconcile earned feature choices</legend>
            <p class="field-hint">The subclass changes the options for the first two Thrill of the Hunt choices. Confirm the two choices that remain on the sheet.</p>
            <% @story_subclass_feature_choice_pools.each do |pool| %>
              <% field_name = "story_subclass_change[feature_choices][#{pool.fetch('name')}][#{pool.fetch('level')}][]" %>
              <div class="field">
                <%= label_tag field_name, "Level #{pool.fetch('level')} · choose #{pool.fetch('count')} #{pool.fetch('name')} abilities" %>
                <%= select_tag field_name, options_for_select(pool.fetch("options").map { |option| [ option, option ] }, pool.fetch("selected")), multiple: true, required: true, size: [ pool.fetch("count").to_i + 2, 5 ].max, class: "choice-select" %>
                <span class="field-hint"><%= pool.fetch("story_source_quote") %> (<%= pool.fetch("story_source_ref") %>)</span>
              </div>
            <% end %>
          </fieldset>
        <% end %>
        <%= form.submit "Approve story change", class: "button button-primary" %>
      <% end %>
    <% end %>

    <% if @story_subclass_changes.any? %>
      <div class="story-subclass-history" aria-label="Story subclass change history">
        <% @story_subclass_changes.each do |change| %>
          <article class="story-subclass-entry">
            <div><strong><%= change.from_subclass %> → <%= change.to_subclass %></strong><span><%= change.approved_by_account.display_name %> · <%= change.campaign.name %> · <%= change.source_ref %></span></div>
            <p><%= change.story_note %></p>
            <% change.subclass_choice_entries.each do |entry| %>
              <p class="story-subclass-choice"><%= entry.fetch(:label) %>: <%= entry.fetch(:value) %> · <%= entry.fetch(:source_refs).join("; ") %></p>
            <% end %>
            <time datetime="<%= change.created_at.iso8601 %>"><%= l(change.created_at, format: :short) %></time>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
