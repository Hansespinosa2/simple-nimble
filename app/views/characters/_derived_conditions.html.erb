<% entries = character.derived_condition_entries %>
<% if entries.any? %>
  <section class="panel derived-condition-panel" aria-label="Conditions derived from hit points and wounds">
    <div class="panel-heading compact">
      <div><p class="eyebrow">Current states</p><h2>HP &amp; Wounds</h2></div>
      <span class="mini-label">Derived · read-only</span>
    </div>
    <div class="derived-condition-list">
      <% entries.each do |entry| %>
        <span class="derived-condition-chip"><%= entry.fetch("name") %></span>
      <% end %>
    </div>
    <details class="condition-rule-note">
      <summary>Why these appear · <%= entries.first.fetch("source_ref") %></summary>
      <ul>
        <% entries.each do |entry| %>
          <li><strong><%= entry.fetch("name") %>:</strong> <%= entry.fetch("source_quote") %> (<%= entry.fetch("source_ref") %>)</li>
          <% if entry["actions_limited_to"].present? %>
            <li><strong><%= entry.fetch("name") %> effect:</strong> <%= entry.fetch("effects_source_quote") %> (<%= entry.fetch("effects_source_ref") %>)</li>
          <% end %>
        <% end %>
      </ul>
      <p><%= Rules::NimbleCatalog.condition_tracking.fetch("tracker_note") %></p>
    </details>
  </section>
<% end %>
