<% content_for :title, "Characters" %>

<div class="page-shell dashboard-shell">
  <% if notice.present? %><div class="alert-card alert-card-success"><span class="alert-icon">✓</span><span><%= notice %></span></div><% end %>

  <section class="dashboard-hero">
    <div>
      <p class="eyebrow">Nimble character vault</p>
      <h1>Your heroes</h1>
      <p class="hero-subtitle">Build cleanly. Play confidently. Keep every important change in one place.</p>
    </div>
    <div class="page-footer-actions">
      <%= link_to "Import character", new_character_import_path, class: "button button-secondary" %>
      <%= link_to "+ New character", new_character_path, class: "button button-primary" %>
    </div>
  </section>

  <div class="dashboard-metrics">
    <div class="metric-card"><span class="metric-icon metric-icon-gold">✦</span><div><strong><%= @characters.count { |character| character.playable? } %></strong><span>Playable</span></div></div>
    <div class="metric-card"><span class="metric-icon metric-icon-blue">◌</span><div><strong><%= @characters.count { |character| character.draft? } %></strong><span>Drafts</span></div></div>
    <div class="metric-card"><span class="metric-icon metric-icon-green">↗</span><div><strong><%= @characters.sum { |character| character.level.to_i } %></strong><span>Total levels</span></div></div>
  </div>

  <div class="list-toolbar">
    <div><p class="eyebrow">Your roster</p><h2><%= pluralize(@characters.size, "character") %></h2></div>
    <%= form_with url: characters_path, method: :get, class: "search-form", local: true do |form| %>
      <%= form.search_field :q, value: params[:q], placeholder: "Search characters…", aria: { label: "Search characters" } %>
      <%= form.submit "Search", class: "button button-quiet" %>
    <% end %>
  </div>

  <div id="characters" class="character-grid">
    <% if @characters.any? %>
      <% @characters.each do |character| %>
        <article class="character-card">
          <div class="character-card-topline">
            <span class="<%= status_badge_class(character.status) %>"><%= character.status_label %></span>
            <span class="card-level">LV <%= character.level || "—" %></span>
          </div>
          <div class="character-identity">
            <div class="avatar avatar-<%= character.id.to_i % 5 %>"><%= (character.name.presence || "?")[0, 2].upcase %></div>
            <div>
              <h3><%= character.name.presence || "Untitled hero" %></h3>
              <p><%= [ character.character_class&.name || character.nimble_class, character.ancestry&.name || character.race ].compact.join(" · ").presence || "Choose a class and ancestry" %></p>
            </div>
          </div>
          <div class="character-card-stats">
            <div><span>HP</span><strong><%= character.trait_set&.current_hp || "—" %>/<%= character.trait_set&.max_hp || "—" %></strong></div>
            <div><span>Armor</span><strong><%= character.trait_set&.armor || "—" %></strong></div>
            <div><span>Updated</span><strong><%= time_ago_in_words(character.updated_at) %></strong></div>
          </div>
          <div class="character-card-actions">
            <%= link_to "Open sheet", character, class: "button button-secondary" %>
            <%= link_to "Edit", edit_character_path(character), class: "button button-quiet" %>
            <% if character.level_up_eligible? %><%= link_to "Level up", new_character_level_up_path(character), class: "button button-quiet" %><% end %>
          </div>
        </article>
      <% end %>
    <% else %>
      <section class="empty-state">
        <div class="empty-state-mark">✦</div>
        <h2>Your next great character starts here.</h2>
        <p>Save an unfinished draft while you explore the rules, then finalize only when the whole build is legal.</p>
        <%= link_to "Build a character", new_character_path, class: "button button-primary" %>
      </section>
    <% end %>
  </div>
</div>
