<% class_features = character.progression_features_through %>
<% subclass_features = character.subclass_progression_features_through %>
<% feature_choices = character.feature_choice_entries_through %>
<% spell_choices = character.spell_choice_entries_through %>
<% companion = character.subclass_choices.to_h.stringify_keys.fetch("companion", {}).to_h.stringify_keys %>
<% companion_rule = character.story_subclass_companion_rule %>
<% companion_abilities = character.story_subclass_companion_ability_entries %>
<% if class_features.any? || subclass_features.any? || feature_choices.any? || spell_choices.any? %>
  <section class="panel progression-panel">
    <div class="panel-heading compact">
      <div><p class="eyebrow">Class progression</p><h2>Features unlocked</h2></div>
      <span class="mini-label"><%= character.character_class&.source_reference || character.rules_source_reference %></span>
    </div>
    <div class="progression-history">
      <% class_features.each do |feature| %>
        <div class="progression-entry"><span>Level <%= feature.fetch(:level) %></span><strong><%= feature.fetch(:name) %></strong><em>Class</em></div>
      <% end %>
      <% subclass_features.each do |feature| %>
        <div class="progression-entry progression-entry-subclass"><span>Level <%= feature.fetch(:level) %></span><strong><%= feature.fetch(:name) %></strong><em><%= character.subclass_name %></em></div>
      <% end %>
      <% if companion.present? %>
        <div class="progression-entry progression-entry-subclass"><span>Companion</span><strong><%= companion.fetch("name") %></strong><em><%= companion.fetch("size") %> animal · <%= companion_rule.fetch("source_ref") %></em><small><%= companion_rule.fetch("behavior_quote") %></small></div>
        <% companion_abilities.each do |ability| %>
          <div class="progression-entry progression-entry-choice"><span>Companion ability</span><strong><%= ability.fetch(:name) %></strong><em><%= ability.fetch(:effect) %></em><small><%= [ ability[:action_cost], ability[:cost], ability[:uses], ability[:uses_per_round], ability.fetch(:source_ref) ].compact.join(" · ") %></small></div>
        <% end %>
        <p class="field-hint"><%= companion_rule.fetch("general_note") %> (<%= companion_rule.fetch("source_ref") %>)</p>
      <% end %>
      <% feature_choices.each do |choice| %>
        <div class="progression-entry progression-entry-choice"><span>Level <%= choice.fetch(:level) %></span><strong><%= choice.fetch(:name) %></strong><em><%= choice.fetch(:selected).join(", ") %></em><small><%= choice.fetch(:source_refs).join(" · ") %></small></div>
      <% end %>
      <% spell_choices.each do |choice| %>
        <div class="progression-entry progression-entry-choice progression-entry-spell"><span>Level <%= choice.fetch(:level) %></span><strong><%= choice.fetch(:name) %></strong><em><%= choice.fetch(:selected).join(", ") %></em></div>
      <% end %>
    </div>
  </section>
<% end %>
