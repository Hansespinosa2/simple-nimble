<% if character.character_class.present? %>
  <section class="panel starting-equipment-panel" aria-labelledby="starting-equipment-heading">
    <div class="panel-heading compact">
      <div><p class="eyebrow">Starting loadout</p><h2 id="starting-equipment-heading">Equipment</h2></div>
      <span class="mini-label"><%= character.starting_equipment_choice == "starting_gold" ? "Gold start" : "Class gear" %></span>
    </div>
    <p><strong><%= character.starting_equipment.presence || "Not recorded" %></strong></p>
    <p class="muted"><%= starting_equipment_context(character) %></p>
    <% if character.starting_gear_inventory_items.any? %>
      <details class="starting-gear-breakdown">
        <summary>Starting gear slots and sources</summary>
        <ul class="starting-gear-list">
          <% character.starting_gear_inventory_items.each do |item| %>
            <li>
              <strong><%= item.fetch("name") %></strong>
              <span><%= item.fetch("slots") %> <%= "slot" if item.fetch("slots").to_i == 1 %><%= "slots" if item.fetch("slots").to_i != 1 %></span>
              <small><%= item.fetch("source_ref") %></small>
            </li>
          <% end %>
        </ul>
        <p class="muted"><%= Rules::NimbleCatalog.data.fetch("starting_gear_inventory").fetch("miscellaneous_item_note") %> <%= Rules::NimbleCatalog.data.fetch("starting_gear_inventory").fetch("source_ref") %>.</p>
      </details>
    <% end %>
  </section>
<% end %>
