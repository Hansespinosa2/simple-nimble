<% content_for :title, "Build a character" %>

<div class="page-shell">
  <% if notice.present? %><div class="alert-card alert-card-success"><span class="alert-icon">✓</span><span><%= notice %></span></div><% end %>
  <%= render "form", character: @character, read_only: false %>
  <div class="page-footer-actions">
    <%= link_to "← Back to characters", characters_path, class: "text-link" %>
  </div>
</div>
