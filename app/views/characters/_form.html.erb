<% builder_payload = defined?(@builder_rules) && @builder_rules.present? ? @builder_rules.to_json : {}.to_json %>
<% max_skill = Rules::NimbleCatalog.derived_values.fetch("max_skill").to_i %>
<% starting_equipment_rules = Rules::NimbleCatalog.starting_equipment_rules %>

<%= form_with(model: character, class: "builder-form", data: { controller: "character-builder", character_builder_rules_value: builder_payload }) do |form| %>
  <% if character.errors.any? %>
    <section class="alert-card alert-card-danger" id="error_explanation" aria-live="polite">
      <div class="alert-icon">!</div>
      <div>
        <h2><%= pluralize(character.errors.count, "thing") %> needs attention</h2>
        <ul>
          <% character.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="builder-header">
    <div>
      <p class="eyebrow"><%= character.persisted? ? "Character sheet" : "New character" %></p>
      <h1><%= character.name.presence || "Untitled hero" %></h1>
      <p class="muted">Make the choices once. Nimble handles the math.</p>
    </div>
    <div class="builder-header-meta">
      <span class="<%= status_badge_class(character.status) %>"><%= character.status_label %></span>
      <span class="rules-context"><span class="context-dot"></span><%= character.rules_context_label %></span>
    </div>
  </section>

  <div class="builder-grid">
    <div class="builder-main-column">
      <section class="panel panel-featured">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Identity</p>
            <h2>Tell us about your hero</h2>
          </div>
          <span class="step-number">01</span>
        </div>
        <div class="form-grid form-grid-two">
          <div class="field field-wide">
            <%= form.label :name, "Character name" %>
            <%= form.text_field :name, id: "character_name", placeholder: "e.g. Mira Ashfall", disabled: read_only, autocomplete: "off" %>
            <span class="field-hint">A name is optional while you are drafting.</span>
          </div>
          <div class="field">
            <%= form.label :level, "Level" %>
            <% level_editable = character.new_record? || character.draft? %>
            <%= form.number_field :level, id: "character_level", min: 1, max: Character::MAX_LEVEL, disabled: read_only || !level_editable, data: { character_builder_target: "level", action: "input->character-builder#refresh change->character-builder#refresh" } %>
            <span class="field-hint"><%= level_editable ? "New heroes start at level 1; drafts can be adjusted before finalizing." : "Level changes happen through the explicit Level up flow." %></span>
          </div>
          <div class="field field-wide">
            <%= form.label :description, "The short version" %>
            <%= form.text_area :description, id: "character_description", rows: 3, placeholder: "What makes this hero worth following?", disabled: read_only %>
          </div>
          <div class="field field-wide">
            <%= form.label :legacy_background_text, "Story notes" %>
            <%= form.text_field :legacy_background_text, id: "character_background", placeholder: "A vow, a rumor, a reason to adventure…", disabled: read_only %>
            <span class="field-hint">Flavor only. The rules background is chosen below.</span>
          </div>
        </div>
      </section>

      <section class="panel panel-featured" data-character-builder-target="choicesPanel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Rules choices</p>
            <h2>Build the foundation</h2>
            <p class="panel-subtitle">These decisions drive every derived value on the sheet.</p>
          </div>
          <span class="step-number">02</span>
        </div>
        <div class="form-grid form-grid-two">
          <div class="field">
            <%= form.label :character_class_id, "Class" %>
            <%= form.collection_select :character_class_id, @character_classes, :id, :name, { include_blank: "Choose a class" }, disabled: read_only, data: { character_builder_target: "characterClass", action: "change->character-builder#refresh" } %>
            <span class="field-hint" data-character-builder-target="classHint">Two Key Stats shape your build.</span>
          </div>
          <div class="field">
            <%= form.label :ancestry_id, "Ancestry" %>
            <%= form.collection_select :ancestry_id, @ancestries, :id, :name, { include_blank: "Choose an ancestry" }, disabled: read_only, data: { character_builder_target: "ancestry", action: "change->character-builder#refresh" } %>
            <span class="field-hint" data-character-builder-target="ancestryHint">Ancestry traits apply automatically.</span>
          </div>
          <div class="field">
            <%= form.label :background_id, "Background" %>
            <%= form.collection_select :background_id, @backgrounds, :id, :name, { include_blank: "Choose a background" }, disabled: read_only, data: { character_builder_target: "background", action: "change->character-builder#refresh" } %>
            <span class="field-hint" data-character-builder-target="backgroundHint">Backgrounds can have creation prerequisites.</span>
          </div>
          <% if character.new_record? || character.draft? %>
            <div class="field field-wide">
              <%= form.label :starting_equipment_choice, "Starting equipment" %>
              <%= form.select :starting_equipment_choice, [["Class's listed starting gear", "class_gear"], ["Starting gold instead (#{starting_equipment_rules.fetch('gold_per_level')} gp per level)", "starting_gold"]], {}, disabled: read_only, data: { character_builder_target: "startingEquipmentChoice", action: "change->character-builder#refresh" } %>
              <span class="field-hint">Core Rules 2.0.1, pp. 20, 32–33; Heroes 2.0.1, p. 67 · choose listed class gear or <%= starting_equipment_rules.fetch("gold_per_level") %> gp per starting level; higher-level starts multiply the gold by level. Equipped catalog armor updates Armor on the sheet; adding gear does not automatically deduct its cost from tracked gold.</span>
              <span class="field-hint" data-character-builder-target="backgroundEquipmentNote" role="note"><%= starting_equipment_rules.fetch("background_gear_note") %> <%= starting_equipment_rules.fetch("background_gear_source_ref") %>.</span>
            </div>
          <% end %>
          <div class="field">
            <%= form.label :stat_array, "Stat array" %>
            <%= form.select :stat_array, @stat_arrays.map { |array| [ array.humanize, array ] }, { include_blank: "Choose an array" }, disabled: read_only, data: { character_builder_target: "statArray", action: "change->character-builder#refresh" } %>
            <span class="field-hint stat-array-rules-summary"><%= stat_array_rules_summary %></span>
          </div>
          <div class="field field-wide" data-character-builder-target="spellSchoolChoiceField">
            <%= form.label :spell_school_choice, "Additional spell school" %>
            <%= form.select :spell_school_choice, (character.character_class&.spell_school_choice_options || []).map { |school| [ school, school ] }, { include_blank: "Choose one additional school" }, disabled: read_only, data: { character_builder_target: "spellSchoolChoice" } %>
            <% school_choice_rule = character.character_class&.spell_school_choice_rule %>
            <span class="field-hint" data-character-builder-target="spellSchoolChoiceHint"><%= "#{school_choice_rule.fetch('source_quote')} (#{school_choice_rule.fetch('source_ref')})" if school_choice_rule.present? %></span>
          </div>
          <% Rules::NimbleCatalog.background_spell_choices.each do |background_name, choice_rule| %>
            <% background_record = @backgrounds.find { |candidate| candidate.name == background_name } %>
            <% next unless background_record %>
            <% choice_label = choice_rule.fetch("choice_label", "Spell") %>
            <% choice_count = choice_rule.fetch("count", 1).to_i %>
            <% choice_options = case choice_rule.fetch("kind") %>
              <% when "utility_spell_any" %>
                <% Spell.where(tier: -1).order(:school, :name).map { |spell| [ "#{spell.school} · #{spell.name}", spell.name ] } %>
              <% when "utility_spell" %>
                <% Spell.where(tier: -1, school: Array(choice_rule.fetch("allowed_schools", []))).order(:school, :name).map { |spell| [ "#{spell.school} · #{spell.name}", spell.name ] } %>
              <% when "spell_up_to_tier" %>
                <% Spell.where(tier: 0..choice_rule.fetch("max_tier").to_i).order(:school, :name).map { |spell| [ "#{spell.school} · #{spell.name}", spell.name ] } %>
              <% when "utility_school" %>
                <% Array(choice_rule.fetch("allowed_schools", [])).map { |school| [ school, school ] } %>
              <% else %>
                <% Array(choice_rule.fetch("options", [])).map { |option| [ option, option ] } %>
              <% end %>
            <div class="field field-wide" data-character-builder-target="backgroundSpellChoiceField" data-background-id="<%= background_record.id %>" <%= "hidden" unless character.background&.name == background_name %>>
              <% choice_count.times do |choice_index| %>
                <% field_name = "character[spell_choices][#{background_name}][1][]" %>
                <% field_id = "character_spell_choices_#{background_record.id}_1_#{choice_index}" %>
                <% field_label = "#{background_name} · #{choice_label}#{" #{choice_index + 1}" if choice_count > 1}" %>
                <%= label_tag field_id, field_label %>
                <%= select_tag field_name, options_for_select([["Choose a #{choice_label}", ""]] + choice_options, character.spell_choice_selections_for(background_name, 1)[choice_index]), id: field_id, disabled: read_only, data: { character_builder_target: "backgroundSpellChoice" } %>
              <% end %>
              <span class="field-hint"><%= choice_rule.fetch("source_ref") %> · “<%= choice_rule.fetch("source_quote") %>”</span>
            </div>
          <% end %>
        </div>
        <div class="rules-callout" data-character-builder-target="rulesCallout">
          <span class="callout-icon">✦</span>
          <span>Choose a class, ancestry, background, and stat array to see how the rules combine.</span>
        </div>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Automatic math</p>
            <h2>Core stats</h2>
            <p class="panel-subtitle">The app assigns the array to Key and Secondary Stats for you.</p>
          </div>
          <span class="step-number">03</span>
        </div>
        <div class="stat-strip" data-character-builder-target="statsPreview">
          <% Character::STAT_NAMES.each do |stat| %>
            <div class="stat-card">
              <span class="stat-abbr"><%= stat_display_name(stat) %></span>
              <strong data-stat-value="<%= stat %>"><%= signed_value(character.stat_value(stat)) %></strong>
              <span class="stat-caption" data-stat-role="<%= stat %>">Secondary</span>
            </div>
          <% end %>
        </div>
        <% stat_options = Character::STAT_ARRAYS[character.stat_array].to_a.uniq.sort.reverse.map { |value| [ signed_value(value), value ] } %>
        <div class="stat-placement-panel">
          <div>
            <strong>Place the array</strong>
            <p class="field-hint">The rules recommend putting the highest values in Key Stats, but you may place each value in any stat.</p>
          </div>
          <div class="stat-placement-grid">
            <% Character::STAT_NAMES.each do |stat| %>
              <% selected_value = character.stat_assignment_value(stat) || (character.stat_array.present? ? character.stat_value(stat) : nil) %>
              <label class="stat-placement-field">
                <span><%= stat_display_name(stat) %></span>
                <%= select_tag "character[stat_assignments][#{stat}]", options_for_select([["Choose", ""]] + stat_options, selected_value), disabled: read_only, data: { character_builder_target: "statAssignment", stat: stat, action: "change->character-builder#refresh" } %>
              </label>
            <% end %>
          </div>
        </div>
        <div class="derived-strip">
          <% save_summary = character.character_class ? "#{stat_display_name(character.character_class.save_bonus_stat)}+ / #{stat_display_name(character.character_class.save_penalty_stat)}−" : "—" %>
          <div class="derived-item"><span>Starting HP</span><strong data-character-builder-target="hpPreview"><%= character.trait_set&.max_hp || "—" %></strong></div>
          <div class="derived-item"><span>Armor</span><strong data-character-builder-target="armorPreview"><%= character.trait_set&.armor || "—" %></strong></div>
          <div class="derived-item"><span>Initiative</span><strong data-character-builder-target="initiativePreview"><%= signed_value(character.trait_set&.initiative) if character.trait_set %></strong></div>
          <div class="derived-item"><span>Hit Die</span><strong data-character-builder-target="hitDiePreview"><%= character.trait_set&.hit_die || "—" %></strong></div>
          <div class="derived-item"><span>Save DC</span><strong data-character-builder-target="saveDcPreview"><%= character.trait_set&.save_dc || "—" %></strong></div>
          <div class="derived-item"><span>Saves</span><strong data-character-builder-target="savesPreview"><%= save_summary %></strong></div>
          <div class="derived-item"><span>Mana</span><strong data-character-builder-target="manaPreview"><%= character.trait_set&.max_mana || "—" %></strong></div>
        </div>
        <% language_rules = Rules::NimbleCatalog.language_rules %>
        <fieldset class="language-choice-panel">
          <legend>Languages</legend>
          <p class="field-hint"><%= language_rules.fetch("source_quote") %> Origin grants apply automatically when their INT requirement is met; choose one distinct language for each positive INT point.</p>
          <div class="language-choice-grid">
            <%= hidden_field_tag "character[language_choices][]", "" if character.new_record? || Array(character.language_choices).any? %>
            <% language_rules.fetch("languages").reject { |language| language == language_rules.fetch("default_language") }.each do |language| %>
              <label class="language-choice-option" data-language-choice-option="<%= language %>">
                <%= check_box_tag "character[language_choices][]", language, Array(character.language_choices).include?(language), disabled: read_only, data: { language_choice: true, action: "change->character-builder#refresh" } %>
                <span><%= language %></span>
              </label>
            <% end %>
          </div>
          <span class="field-hint" data-character-builder-target="languageChoiceHint"><%= character.language_choice_count %> INT language choice(s) required · <%= language_rules.fetch("source_ref") %></span>
        </fieldset>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Your edge</p>
            <h2>Skill points</h2>
            <p class="panel-subtitle">Spend <strong><%= character.skill_point_budget %></strong> extra points at level <%= character.level || 1 %>. Skills cannot exceed +<%= max_skill %>.</p>
            <small class="source-note skill-rule-note">Rules basis: <%= Rules::NimbleCatalog.derived_values.fetch("skill_point_progression_note") %> (<%= Rules::NimbleCatalog.derived_values.fetch("skill_point_progression_source_ref") %>).</small>
          </div>
          <span class="step-number">04</span>
        </div>
        <div class="skill-grid">
          <%= form.fields_for :skill_set do |skill_fields| %>
            <% Character::SKILL_NAMES.each do |skill| %>
              <div class="skill-field">
                <%= skill_fields.label skill, skill_display_name(skill) %>
                <%= skill_fields.number_field skill, min: -5, max: max_skill, disabled: read_only, data: { skill: skill } %>
                <span data-skill-base="<%= skill %>">base <%= signed_value(character.skill_initial_value(skill)) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="skill-budget" data-character-builder-target="skillBudget">Spend <strong><%= character.skill_points_spent %>/<%= character.skill_point_budget %></strong> extra points</div>
      </section>
    </div>

    <aside class="builder-side-column">
      <section class="panel preview-panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">Live preview</p>
            <h2>What changes</h2>
          </div>
          <span class="preview-pulse"></span>
        </div>
        <div class="preview-list">
          <div><span>Rules context</span><strong><%= character.rules_context_label %></strong></div>
          <div><span>Languages</span><strong data-character-builder-target="languagesPreview"><%= character.languages.presence || "Common" %></strong></div>
          <div><span>Speed</span><strong data-character-builder-target="speedPreview"><%= character.trait_set&.speed || "—" %></strong></div>
          <div><span>Max wounds</span><strong data-character-builder-target="woundsPreview"><%= character.trait_set&.max_wounds || "—" %></strong></div>
          <div><span>Class resource</span><strong data-character-builder-target="resourcePreview"><%= character.trait_set&.resource_name || "—" %></strong></div>
          <div><span>Starting equipment</span><strong data-character-builder-target="startingEquipmentPreview"><%= character.starting_equipment.presence || "Choose a class to see its gear" %></strong></div>
        </div>
        <div class="preview-note" data-character-builder-target="previewNote">Derived values update as you choose.</div>
        <p class="preview-note derived-effect-note" data-character-builder-target="derivedEffectNote" role="note" aria-live="polite" hidden></p>
      </section>

      <section class="panel">
        <div class="panel-heading compact">
          <div>
            <p class="eyebrow">Optional</p>
            <h2>Spells</h2>
          </div>
          <span class="mini-label">Reference</span>
        </div>
        <% if read_only %>
          <div class="spell-chips">
            <% character.sheet_spells.order(:tier, :name).each do |spell| %>
              <span class="spell-chip <%= color_from_spell_school(spell.school) %>"><%= spell.name %></span>
            <% end %>
            <% if character.sheet_spells.empty? %><span class="muted">No spells chosen.</span><% end %>
          </div>
        <% else %>
          <% spells_for_picker = character.character_class.present? ? character.available_spells : Spell.order(:tier, :name) %>
          <div class="spell-picker">
            <% if spells_for_picker.any? %>
              <%= form.collection_check_boxes :spell_ids, spells_for_picker, :id, :name do |check| %>
                <label class="spell-option">
                  <%= check.check_box %>
                  <span><%= check.object.name %></span>
                  <small>Tier <%= check.object.tier %> · <%= check.object.school %></small>
                </label>
              <% end %>
            <% else %>
              <span class="muted">No spells are available to this class at this level.</span>
            <% end %>
          </div>
        <% end %>
      </section>

      <% unless read_only %>
        <section class="panel action-panel">
          <p class="muted">Drafts are safe to save at any point. Finalizing runs every rules check.</p>
          <%= form.submit "Save draft", class: "button button-secondary" %>
          <%= button_tag "Save and mark playable", type: "submit", name: "finalize", value: "1", class: "button button-primary" %>
        </section>
      <% end %>
    </aside>
  </div>
<% end %>
