<% content_for :title, @character.name.presence || "Character sheet" %>
<% resting_rules = Rules::NimbleCatalog.resting_rules %>
<% safe_rest_rules = resting_rules.fetch("safe_rest") %>
<% field_rest_rules = resting_rules.fetch("field_rests") %>
<% catch_breath_rules = field_rest_rules.fetch("catch_breath") %>
<% make_camp_rules = field_rest_rules.fetch("make_camp") %>

<div class="page-shell sheet-shell">
  <% if notice.present? %><div class="alert-card alert-card-success"><span class="alert-icon">✓</span><span><%= notice %></span></div><% end %>
  <% if alert.present? %><div class="alert-card alert-card-danger"><span class="alert-icon">!</span><span><%= alert %></span></div><% end %>

  <header class="sheet-header">
    <div class="sheet-title-block">
      <%= link_to "← Your characters", characters_path, class: "text-link" %>
      <div class="sheet-title-row">
        <div class="avatar avatar-large avatar-<%= @character.id.to_i % 5 %>"><%= (@character.name.presence || "?")[0, 2].upcase %></div>
        <div>
          <p class="eyebrow">Nimble character sheet</p>
          <h1><%= @character.name.presence || "Untitled hero" %></h1>
          <p class="sheet-subtitle"><%= [ @character.character_class&.name || @character.nimble_class, @character.subclass_name, @character.ancestry&.name || @character.race, "Level #{@character.level || '—'}" ].compact.join(" · ") %></p>
          <% if @character.description.present? %><p class="sheet-description"><%= @character.description %></p><% end %>
        </div>
      </div>
    </div>
    <div class="sheet-header-actions">
      <span class="<%= status_badge_class(@character.status) %>"><%= @character.status_label %></span>
      <%= link_to "Edit sheet", edit_character_path(@character), class: "button button-secondary" %>
      <% if @character.level_up_eligible? %><%= link_to "Level up", new_character_level_up_path(@character), class: "button button-primary" %><% end %>
    </div>
  </header>

  <% if @character.draft? && @character.creation_explanations.any? %>
    <section class="rules-review-panel">
      <div class="rules-review-heading"><div><p class="eyebrow">Finish your draft</p><h2>Almost playable</h2><p>Resolve these rules checks before you enter a game.</p></div><%= link_to "Continue editing", edit_character_path(@character), class: "button button-secondary" %></div>
      <div class="explanation-grid">
        <% @character.creation_explanations.each do |explanation| %>
          <div class="explanation explanation-blocked"><span class="explanation-marker">!</span><div><strong><%= explanation[:message] %></strong><small><%= explanation[:source_ref] %> · “<%= explanation[:quote] %>”</small></div></div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="vitals-grid">
    <div class="vital-card vital-card-hp"><span class="vital-label">Current HP</span><strong><%= @character.trait_set&.current_hp || "—" %><small> / <%= @character.trait_set&.max_hp || "—" %></small></strong><span class="vital-foot">Temp <%= @character.trait_set&.temp_hp || 0 %></span></div>
    <div class="vital-card"><span class="vital-label">Armor</span><strong><%= @character.trait_set&.armor || "—" %></strong><span class="vital-foot"><%= armor_rule_caption(@character) %></span></div>
    <div class="vital-card"><span class="vital-label">Initiative</span><strong><%= signed_value(@character.trait_set&.initiative) if @character.trait_set %></strong><span class="vital-foot">DEX + origin</span></div>
    <div class="vital-card"><span class="vital-label">Save DC</span><strong><%= @character.trait_set&.save_dc || "—" %></strong><span class="vital-foot save-dc-formula"><%= save_dc_formula_caption %></span></div>
    <div class="vital-card"><span class="vital-label">Mana</span><strong><%= @character.trait_set&.current_mana || "—" %><small><%= " / #{@character.trait_set.max_mana}" if @character.trait_set&.max_mana %></small></strong><span class="vital-foot">Safe Rest recharge</span></div>
    <div class="vital-card"><span class="vital-label">Speed</span><strong><%= @character.trait_set&.speed || "—" %></strong><span class="vital-foot">spaces</span></div>
    <%= render "characters/wound_tracker_card", character: @character %>
  </section>
  <%= render "characters/derived_conditions", character: @character %>

  <% resource_tracks = @character.trait_set&.resource_tracks.to_a %>
  <% story_feature_notes = @character.story_subclass_feature_note_entries.index_by { |note| note.fetch("name") } %>
  <% shadow_minion_rule = Rules::NimbleCatalog.class_resource_pool_for("Shadowmancer", "shadow_minions") %>
  <% shadow_exploit_cost_rule = Rules::NimbleCatalog.story_subclass_resource_pool_for("Shadowmancer", "Reaver", "reaver_shadow_exploit_next_cost") %>
  <% if resource_tracks.any? %>
    <section class="panel resource-summary-panel">
      <div class="panel-heading compact"><div><p class="eyebrow">Game resources</p><h2>Ready to spend</h2></div><span class="mini-label">Tracked with the sheet</span></div>
      <div class="resource-summary-grid">
        <% resource_tracks.each do |track| %>
          <div class="resource-summary-item">
            <span><%= track.fetch("name") %></span>
            <strong><%= track.fetch("current") %><small><%= " / #{track['max']}" if track["max"].present? %></small></strong>
            <em><%= track["reset"] %></em>
            <% if track["source_ref"].present? %>
              <details class="resource-rule-note">
                <summary>Rule · <%= track.fetch("source_ref") %></summary>
                <p><%= track.fetch("source_quote") %></p>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "progression_panel", character: @character %>

  <div class="sheet-grid">
    <div class="sheet-main-column">
      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Abilities</p><h2>Stats & skills</h2></div><span class="mini-label">Rules-derived</span></div>
        <div class="sheet-stat-grid">
          <% Character::STAT_NAMES.each do |stat| %>
            <div class="sheet-stat"><span><%= stat_display_name(stat) %></span><strong><%= signed_value(@character.stat_value(stat)) %></strong><small><%= @character.character_class&.key_stats&.include?(stat) ? "Key" : "Secondary" %></small></div>
          <% end %>
        </div>
        <div class="sheet-skill-grid">
          <% Character::SKILL_NAMES.each do |skill| %>
            <div class="sheet-skill"><span><%= skill_display_name(skill) %></span><strong><%= signed_value(@character.skill_value(skill)) %></strong></div>
          <% end %>
        </div>
      </section>

      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Origin</p><h2>Rules context</h2></div><span class="rules-context"><span class="context-dot"></span><%= @character.rules_context_label %></span></div>
        <div class="origin-grid">
          <div class="origin-card"><span class="origin-label">Class</span><strong><%= [ @character.character_class&.name || @character.nimble_class || "Not chosen", @character.subclass_name ].compact.join(" · ") %></strong><p><%= @character.character_class ? "#{@character.character_class.key_stats.map { |stat| stat_display_name(stat) }.join(' + ')} Key Stats · #{@character.character_class.hit_die} · Saves #{stat_display_name(@character.character_class.save_bonus_stat)}+ / #{stat_display_name(@character.character_class.save_penalty_stat)}−" : "Choose a rules class to unlock derived values." %></p></div>
          <div class="origin-card"><span class="origin-label">Ancestry</span><strong><%= @character.ancestry&.name || @character.race || "Not chosen" %></strong><p><%= @character.ancestry&.trait_summary || "Ancestry traits will appear here." %></p></div>
          <div class="origin-card"><span class="origin-label">Background</span><strong><%= @character.background&.name || @character.legacy_background_text || "Not chosen" %></strong><p><%= @character.background&.description || "Background story notes are kept with the sheet." %></p></div>
          <div class="origin-card"><span class="origin-label">Proficiencies</span><strong><%= @character.character_class&.armor_proficiencies&.join(", ").presence || "None" %></strong><p>Armor · <%= @character.character_class&.weapon_proficiencies&.join(", ").presence || "No weapon category" %></p></div>
          <div class="origin-card"><span class="origin-label">Languages</span><strong><%= @character.languages.presence || "Common" %></strong><p>Common plus INT and ancestry grants.</p></div>
        </div>
      </section>

      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Magic</p><h2>Spells</h2></div><%= link_to "Browse reference", spells_path, class: "text-link" %></div>
        <div class="spell-chips">
          <% @character.sheet_spells.order(:tier, :name).each do |spell| %><%= link_to spell.name, spell, class: "spell-chip #{color_from_spell_school(spell.school)}" %><% end %>
          <% if @character.sheet_spells.empty? %><span class="muted">No spells on this sheet yet.</span><% end %>
        </div>
      </section>
      <%= render "inventory_items", character: @character, editable: true %>
    </div>

    <aside class="sheet-side-column">
      <section class="panel tracker-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">At the table</p><h2>Track the moment</h2></div><span class="mini-label">Autosaved as a revision</span></div>
        <%= form_with model: @character, url: tracker_character_path(@character), method: :patch, class: "tracker-form" do |tracker_form| %>
          <%= tracker_form.fields_for :trait_set do |trait_fields| %>
            <div class="tracker-number-grid">
              <label><span>HP</span><%= trait_fields.number_field :current_hp, min: 0, max: @character.trait_set&.max_hp %></label>
              <label><span>Temp HP</span><%= trait_fields.number_field :temp_hp, min: 0 %></label>
              <label><span>Wounds</span><%= trait_fields.number_field :current_wounds, min: 0, max: @character.trait_set&.max_wounds %></label>
              <label><span>Actions</span><%= trait_fields.number_field :current_actions, min: 0, max: @character.trait_set&.max_actions %></label>
              <label><span>Hit Dice</span><%= trait_fields.number_field :current_hit_dice, min: 0, max: @character.trait_set&.max_hit_dice %></label>
              <label><span>Gold (gp)</span><%= tracker_form.number_field :current_gold, min: 0, step: 1 %></label>
              <% resource_tracks = @character.trait_set&.resource_tracks.to_a %>
              <% if resource_tracks.any? %>
                <% resource_tracks.each do |track| %>
                  <label>
                    <span><%= track.fetch("name") %><small><%= [ (" / #{track['max']}" if track["max"].present?), track["reset"] ].compact.join(" · ") %></small></span>
                    <%= hidden_field_tag "character[trait_set_attributes][resource_tracks][][key]", track.fetch("key") %>
                    <%= number_field_tag "character[trait_set_attributes][resource_tracks][][current]", track["current"], min: 0, max: track["max"] %>
                  </label>
                <% end %>
              <% else %>
                <label><span>Mana</span><%= trait_fields.number_field :current_mana, min: 0, max: @character.trait_set&.max_mana %></label>
                <label><span><%= @character.trait_set&.resource_name.presence || "Resource" %></span><%= trait_fields.number_field :current_resource, min: 0, max: @character.trait_set&.max_resource %></label>
              <% end %>
            </div>
          <% end %>
          <% condition_rules = Rules::NimbleCatalog.condition_tracking %>
          <div class="field">
            <%= tracker_form.label :conditions, "Conditions & minor statuses" %>
            <%= tracker_form.text_field :conditions, placeholder: "e.g. Poisoned, Smoldering, Inspired", list: "nimble-condition-suggestions" %>
            <datalist id="nimble-condition-suggestions">
              <% (condition_rules.fetch("manual_conditions") + condition_rules.fetch("minor_status_examples")).each do |condition_name| %><option value="<%= condition_name %>"><% end %>
            </datalist>
            <span class="field-hint"><%= condition_rules.fetch("source_ref") %> · comma-separate multiple entries; custom table statuses are allowed. <%= condition_rules.fetch("tracker_note") %></span>
          </div>
          <div class="field"><%= tracker_form.label :inventory, "Inventory notes" %><%= tracker_form.text_area :inventory, rows: 3, placeholder: "Loose notes or loot details…" %><span class="field-hint">This text is not included in slot calculations; add carried items to the structured Inventory list.</span></div>
          <div class="field"><%= tracker_form.label :game_notes, "Session notes" %><%= tracker_form.text_area :game_notes, rows: 3, placeholder: "Remember this for next time…" %></div>
          <%= tracker_form.submit "Save game state", class: "button button-primary button-full" %>
        <% end %>
        <% if resource_tracks.any? { |track| Array(track["reset_events"]).include?("encounter_end") } %>
          <% initiative_grant = @character.initiative_resource_grant %>
          <% initiative_track = resource_tracks.find { |track| track.fetch("key") == initiative_grant&.fetch("resource_key") } %>
          <% if initiative_grant.present? && initiative_track.present? %>
            <div class="safe-rest-action">
              <p class="eyebrow"><%= initiative_grant.fetch("feature_label") %></p>
              <p><%= initiative_grant.fetch("description") %> (<%= initiative_grant.fetch("source_ref") %>)</p>
              <% if @character.encounter_started_at.present? %>
                <span class="field-hint">Initiative recorded at <%= l(@character.encounter_started_at, format: :short) %>.</span>
              <% else %>
                <%= button_to(initiative_grant.fetch("action_label").gsub("%{amount}", @character.initiative_resource_amount.to_s), begin_encounter_character_path(@character), method: :patch, class: "button button-secondary button-full") %>
              <% end %>
            </div>
          <% end %>
          <% bonescythe = @character.story_subclass_weapon_entry %>
          <% if bonescythe.present? %>
            <div class="safe-rest-action">
              <p class="eyebrow">Reaver · Bonescythe</p>
              <p class="field-hint"><%= bonescythe.fetch(:invocation_carryover_note) %> (<%= bonescythe.fetch(:source_ref) %>)</p>
              <% if bonescythe.fetch(:summoned) %>
                <p><%= bonescythe.fetch(:damage_dice) %> · <%= bonescythe.fetch(:damage_effect) %> · Reach <%= bonescythe.fetch(:reach) %>. The next hit shatters it.</p>
                <% grim_harrow = story_feature_notes["Grim Harrow"] %>
                <% reap = story_feature_notes["Reap"] %>
                <% if grim_harrow.present? %>
                  <p class="field-hint"><strong>Grim Harrow:</strong> <%= grim_harrow.fetch("effect") %> (<%= grim_harrow.fetch("source_ref") %>)</p>
                <% end %>
                <% if reap.present? %>
                  <p class="field-hint"><strong>Reap:</strong> <%= reap.fetch("effect") %> (<%= reap.fetch("source_ref") %>)</p>
                  <%= button_to "Record Hit · shatter", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "mark_bonescythe_hit", outcome: "hit" } }, class: "button button-secondary button-full" %>
                  <%= button_to "Record Critical Hit · shatter + Reap", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "mark_bonescythe_hit", outcome: "critical" } }, class: "button button-secondary button-full" %>
                  <%= button_to "Record Kill · shatter + Reap", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "mark_bonescythe_hit", outcome: "kill" } }, class: "button button-secondary button-full" %>
                <% else %>
                  <%= button_to "Record Bonescythe Hit · shatter", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "mark_bonescythe_hit", outcome: "hit" } }, class: "button button-secondary button-full" %>
                <% end %>
              <% elsif @character.trait_set&.current_actions.to_i >= bonescythe.fetch(:action_cost).to_i %>
                <p>Summon as a melee weapon: <%= bonescythe.fetch(:damage_dice) %> · <%= bonescythe.fetch(:damage_effect) %> · Reach <%= bonescythe.fetch(:reach) %>. It shatters after one hit or when combat ends.</p>
                <%= button_to "Summon Bonescythe · spend #{pluralize(bonescythe.fetch(:action_cost).to_i, 'action')}", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "summon_bonescythe" } }, class: "button button-secondary button-full" %>
              <% else %>
                <p>Summoning requires <%= pluralize(bonescythe.fetch(:action_cost).to_i, "action") %>. You currently have <%= pluralize(@character.trait_set&.current_actions.to_i, "action") %>.</p>
              <% end %>
            </div>
          <% end %>
          <% shadow_minions = resource_tracks.find { |track| track.fetch("key") == "shadow_minions" } %>
          <% if shadow_minions.present? %>
            <% minion_count = shadow_minions.fetch("current").to_i %>
            <% minion_capacity = shadow_minions.fetch("max").to_i %>
            <% summon_amount = shadow_minion_rule.fetch("summon_amount").to_i %>
            <% summon_action_cost = shadow_minion_rule.fetch("summon_action_cost").to_i %>
            <% reaver = @character.subclass_name == "Reaver" %>
            <div class="safe-rest-action">
              <p class="eyebrow">Shadow Minions · <%= minion_count %> / <%= minion_capacity %></p>
              <p><%= shadow_minion_rule.fetch("summon_source_quote") %> Summoning costs <%= pluralize(summon_action_cost, "action") %>. <%= shadow_minion_rule.fetch("source_quote") %> (<%= shadow_minion_rule.fetch("source_ref") %>)</p>
              <% if reaver && minion_count.positive? && @character.story_subclass_feature_unlocked?("Otherworldly Might") %>
                <% otherworldly_might = story_feature_notes.fetch("Otherworldly Might") %>
                <p class="field-hint"><strong>Otherworldly Might:</strong> <%= otherworldly_might.fetch("effect") %> (<%= otherworldly_might.fetch("source_ref") %>)</p>
              <% end %>
              <% if minion_count + summon_amount <= minion_capacity && @character.trait_set&.current_actions.to_i >= summon_action_cost %>
                <%= button_to "Summon Shadow Minion · spend #{pluralize(summon_action_cost, 'action')}", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "summon_shadow_minion" } }, class: "button button-secondary button-full" %>
              <% end %>
              <% martyr_spawn = story_feature_notes["Martyr Spawn"] %>
              <% if reaver && martyr_spawn.present? %>
                <% martyr_cost = martyr_spawn.fetch("shadow_minions_spent").to_i %>
                <p class="field-hint"><strong>Martyr Spawn:</strong> <%= martyr_spawn.fetch("effect") %> (<%= martyr_spawn.fetch("source_ref") %>)</p>
                <% if minion_count >= martyr_cost %>
                  <%= button_to "Martyr Spawn · spend #{pluralize(martyr_cost, 'minion')} to negate Defend damage", game_feature_character_path(@character), method: :patch, params: { game_feature: { action: "martyr_spawn" } }, class: "button button-secondary button-full" %>
                <% end %>
              <% end %>
              <% if reaver && @character.story_subclass_feature_unlocked?("Shadow Exploit") %>
                <% next_cost = resource_tracks.find { |track| track.fetch("key") == "reaver_shadow_exploit_next_cost" } %>
                <% tiered_spells = @character.sheet_spells.select { |spell| spell.tier.to_i.positive? && spell.available_to?(@character) } %>
                <% if next_cost.present? && tiered_spells.any? %>
                  <% next_cost_increment = shadow_exploit_cost_rule.fetch("increment_per_cast").to_i %>
                  <p class="field-hint">Shadow Exploit casts at your highest unlocked tier; next cost is <%= next_cost.fetch("current") %> minion<%= "s" unless next_cost.fetch("current").to_i == 1 %> and increases by <%= next_cost_increment %> minion<%= "s" unless next_cost_increment == 1 %> after each cast. Spend the spell's normal actions separately. (<%= shadow_exploit_cost_rule.fetch("source_ref") %>)</p>
                  <%= form_with url: game_feature_character_path(@character), method: :patch, scope: :game_feature, class: "field-rest-form" do |feature_form| %>
                    <%= feature_form.hidden_field :action, value: "shadow_exploit" %>
                    <div class="field">
                      <%= feature_form.label :spell_name, "Tiered spell to cast" %>
                      <%= feature_form.select :spell_name, options_for_select(tiered_spells.map { |spell| [ spell.name, spell.name ] }), { include_blank: "Choose a spell" }, required: true, class: "choice-select" %>
                    </div>
                    <%= feature_form.submit "Record Shadow Exploit cast", class: "button button-secondary button-full" %>
                  <% end %>
                <% end %>
                <% if @character.story_subclass_feature_unlocked?("My Blood, My Power") && tiered_spells.any? %>
                  <% my_blood = story_feature_notes.fetch("My Blood, My Power") %>
                  <% wounds_to_take = my_blood.fetch("wounds_to_take").to_i %>
                  <% my_blood_effect = my_blood.fetch("effect").sub(/\b\d+ Wounds?\b/i, "#{wounds_to_take} #{'Wound'.pluralize(wounds_to_take)}") %>
                  <% current_wounds = @character.trait_set&.current_wounds.to_i %>
                  <% max_wounds = @character.trait_set&.max_wounds.to_i %>
                  <p class="field-hint"><strong>My Blood, My Power:</strong> <%= my_blood_effect %> The spell's normal action cost still applies. Current Wounds: <%= current_wounds %> / <%= max_wounds %>. (<%= my_blood.fetch("source_ref") %>)</p>
                  <% if current_wounds + wounds_to_take <= max_wounds %>
                    <%= form_with url: game_feature_character_path(@character), method: :patch, scope: :game_feature, class: "field-rest-form" do |feature_form| %>
                      <%= feature_form.hidden_field :action, value: "my_blood_my_power" %>
                      <div class="field">
                        <%= feature_form.label :spell_name, "Known tiered spell" %>
                        <%= feature_form.select :spell_name, options_for_select(tiered_spells.map { |spell| [ spell.name, spell.name ] }), { include_blank: "Choose a spell" }, required: true, class: "choice-select" %>
                      </div>
                      <%= feature_form.submit "Record My Blood, My Power cast", class: "button button-secondary button-full" %>
                    <% end %>
                  <% else %>
                    <p class="field-hint">You need room for <%= pluralize(wounds_to_take, "Wound") %> and cannot use this feature now.</p>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <div class="safe-rest-action">
            <p class="eyebrow">Encounter End</p>
            <p>Refresh only the counters whose rules reset when an encounter ends. Safe Rest and daily-use counters are left alone.</p>
            <%= button_to "End Encounter · refresh uses", end_encounter_character_path(@character), method: :patch, class: "button button-secondary button-full" %>
          </div>
        <% end %>
        <div class="safe-rest-action">
          <p class="eyebrow">Safe Rest</p>
          <% safe_rest_effects = [] %>
          <% safe_rest_effects << "recover all HP" if safe_rest_rules.fetch("recover_all_hit_points") %>
          <% safe_rest_effects << "recover all Hit Dice" if safe_rest_rules.fetch("recover_all_hit_dice") %>
          <% safe_rest_effects << "heal #{pluralize(safe_rest_rules.fetch('wounds_healed'), 'Wound')}" if safe_rest_rules.fetch("wounds_healed").to_i.positive? %>
          <% safe_rest_effects << "clear Temp HP" if safe_rest_rules.fetch("temporary_hit_points_expire") %>
          <% safe_rest_effects << "refresh tracked rest resources" %>
          <p class="safe-rest-summary">At a GM-designated safe location, <%= safe_rest_effects.to_sentence %>.</p>
          <span class="field-hint"><%= safe_rest_rules.fetch("source_ref") %>; <%= safe_rest_rules.fetch("temporary_hit_points_source_ref") %> · encounter-reset resources return to their starting state.</span>
          <%= button_to "Complete Safe Rest", safe_rest_character_path(@character), method: :patch, class: "button button-secondary button-full" %>
        </div>
        <div class="field-rest-action">
          <p class="eyebrow">Field Rest · <%= @character.trait_set&.hit_die || "Hit Die" %></p>
          <p class="field-rest-summary">Catch Breath takes at least <%= catch_breath_rules.fetch("minimum_duration") %> <%= catch_breath_rules.fetch("duration_unit") %> and resolves <%= pluralize(catch_breath_rules.fetch("hit_dice_per_use"), "Hit Die") %> at a time, adding <%= stat_display_name(catch_breath_rules.fetch("stat_modifier")) %> to each die. Make Camp takes at least <%= make_camp_rules.fetch("minimum_duration") %> <%= make_camp_rules.fetch("duration_unit") %><%= " with food and sleep" if make_camp_rules.fetch("requires_food_and_sleep") %> and uses each die’s maximum, adding <%= stat_display_name(make_camp_rules.fetch("stat_modifier")) %> to each.</p>
          <span class="field-hint"><%= catch_breath_rules.fetch("source_ref") %> · Hit Dice available: <%= @character.trait_set&.current_hit_dice || 0 %></span>
          <% if (@character.trait_set&.current_hit_dice || 0).to_i.positive? %>
            <%= form_with url: field_rest_character_path(@character), method: :patch, scope: :field_rest, class: "field-rest-form" do |rest_form| %>
              <%= rest_form.hidden_field :mode, value: "catch_breath" %>
              <%= rest_form.hidden_field :hit_dice, value: 1 %>
              <div class="field-rest-fields">
                <div class="field"><%= rest_form.label :die_rolls, "Single Hit Die roll (d#{@character.hit_die_sides})", for: "catch_breath_die_rolls" %><%= rest_form.number_field :die_rolls, id: "catch_breath_die_rolls", min: 1, max: @character.hit_die_sides, step: 1 %></div>
              </div>
              <%= rest_form.submit "Catch Breath · #{catch_breath_rules.fetch('minimum_duration')} #{catch_breath_rules.fetch('duration_unit') == 'minutes' ? 'min' : catch_breath_rules.fetch('duration_unit')}", class: "button button-secondary button-full" %>
            <% end %>
            <%= form_with url: field_rest_character_path(@character), method: :patch, scope: :field_rest, class: "field-rest-form" do |rest_form| %>
              <%= rest_form.hidden_field :mode, value: "make_camp" %>
              <div class="field"><%= rest_form.label :hit_dice, "Hit Dice to spend", for: "make_camp_hit_dice" %><%= rest_form.number_field :hit_dice, id: "make_camp_hit_dice", min: 1, max: @character.trait_set.current_hit_dice, value: 1 %></div>
              <%= rest_form.submit "Make Camp · #{make_camp_rules.fetch('minimum_duration')} #{make_camp_rules.fetch('duration_unit')}", class: "button button-secondary button-full" %>
            <% end %>
          <% else %>
            <p class="field-hint">No Hit Dice available to spend.</p>
          <% end %>
        </div>
      </section>

      <section class="panel timeline-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Continuity</p><h2>Recent changes</h2></div><%= link_to "View all", history_character_path(@character), class: "text-link" %></div>
        <div class="timeline">
          <% @revisions.each do |revision| %>
            <div class="timeline-item"><span class="<%= revision_event_class(revision.event_type) %>"></span><div><strong><%= revision.event_label %></strong><p><%= revision.summary %></p><time><%= time_ago_in_words(revision.created_at) %> ago</time></div></div>
          <% end %>
          <% if @revisions.empty? %><p class="muted">Your first save will appear here.</p><% end %>
        </div>
      </section>
    </aside>
  </div>

  <section class="panel sharing-panel">
    <div class="panel-heading compact"><div><p class="eyebrow">Share the sheet</p><h2>Let your table see it</h2><p class="panel-subtitle">Character ownership stays here. Shared views are read-only.</p></div><%= link_to "Campaigns", campaigns_path, class: "text-link" %></div>
    <% if @campaigns.any? %>
      <%= form_with url: character_shares_path(@character), class: "share-form" do |share_form| %>
        <%= share_form.collection_select :campaign_id, @campaigns, :id, :name, { include_blank: "Choose a campaign" } %>
        <%= share_form.submit "Share read-only sheet", class: "button button-secondary" %>
      <% end %>
    <% else %>
      <div class="sharing-empty"><p>Create a campaign workspace first, then share this sheet with a read-only link.</p><%= link_to "Create a campaign", new_campaign_path, class: "button button-secondary" %></div>
    <% end %>
    <% if @character.character_shares.any? %>
      <div class="share-list"><% @character.character_shares.includes(:campaign).each do |share| %><div><span><%= share.campaign.name %></span><%= link_to "Open shared view", shared_character_path(share.share_token), class: "text-link" %></div><% end %></div>
    <% end %>
  </section>

  <div class="page-footer-actions"><%= button_to "Delete character", @character, method: :delete, class: "text-link text-link-danger", data: { turbo_confirm: "Delete this character and its revision history?" } %></div>
</div>
