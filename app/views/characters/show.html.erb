<% content_for :title, @character.name.presence || "Character sheet" %>

<div class="page-shell sheet-shell">
  <% if notice.present? %><div class="alert-card alert-card-success"><span class="alert-icon">✓</span><span><%= notice %></span></div><% end %>
  <% if alert.present? %><div class="alert-card alert-card-danger"><span class="alert-icon">!</span><span><%= alert %></span></div><% end %>

  <header class="sheet-header">
    <div class="sheet-title-block">
      <%= link_to "← Your characters", characters_path, class: "text-link" %>
      <div class="sheet-title-row">
        <div class="avatar avatar-large avatar-<%= @character.id.to_i % 5 %>"><%= (@character.name.presence || "?")[0, 2].upcase %></div>
        <div>
          <p class="eyebrow">Nimble character sheet</p>
          <h1><%= @character.name.presence || "Untitled hero" %></h1>
          <p class="sheet-subtitle"><%= [ @character.character_class&.name || @character.nimble_class, @character.subclass_name, @character.ancestry&.name || @character.race, "Level #{@character.level || '—'}" ].compact.join(" · ") %></p>
          <% if @character.description.present? %><p class="sheet-description"><%= @character.description %></p><% end %>
        </div>
      </div>
    </div>
    <div class="sheet-header-actions">
      <span class="<%= status_badge_class(@character.status) %>"><%= @character.status_label %></span>
      <%= link_to "Edit sheet", edit_character_path(@character), class: "button button-secondary" %>
      <% if @character.level_up_eligible? %><%= link_to "Level up", new_character_level_up_path(@character), class: "button button-primary" %><% end %>
    </div>
  </header>

  <% if @character.draft? && @character.creation_explanations.any? %>
    <section class="rules-review-panel">
      <div class="rules-review-heading"><div><p class="eyebrow">Finish your draft</p><h2>Almost playable</h2><p>Resolve these rules checks before you enter a game.</p></div><%= link_to "Continue editing", edit_character_path(@character), class: "button button-secondary" %></div>
      <div class="explanation-grid">
        <% @character.creation_explanations.each do |explanation| %>
          <div class="explanation explanation-blocked"><span class="explanation-marker">!</span><div><strong><%= explanation[:message] %></strong><small><%= explanation[:source_ref] %> · “<%= explanation[:quote] %>”</small></div></div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="vitals-grid">
    <div class="vital-card vital-card-hp"><span class="vital-label">Current HP</span><strong><%= @character.trait_set&.current_hp || "—" %><small> / <%= @character.trait_set&.max_hp || "—" %></small></strong><span class="vital-foot">Temp <%= @character.trait_set&.temp_hp || 0 %></span></div>
    <div class="vital-card"><span class="vital-label">Armor</span><strong><%= @character.trait_set&.armor || "—" %></strong><span class="vital-foot">Starting gear + origin</span></div>
    <div class="vital-card"><span class="vital-label">Initiative</span><strong><%= signed_value(@character.trait_set&.initiative) if @character.trait_set %></strong><span class="vital-foot">DEX + origin</span></div>
    <div class="vital-card"><span class="vital-label">Save DC</span><strong><%= @character.trait_set&.save_dc || "—" %></strong><span class="vital-foot">10 + KEY</span></div>
    <div class="vital-card"><span class="vital-label">Mana</span><strong><%= @character.trait_set&.current_mana || "—" %><small><%= " / #{@character.trait_set.max_mana}" if @character.trait_set&.max_mana %></small></strong><span class="vital-foot">Safe Rest recharge</span></div>
    <div class="vital-card"><span class="vital-label">Speed</span><strong><%= @character.trait_set&.speed || "—" %></strong><span class="vital-foot">spaces</span></div>
    <div class="vital-card"><span class="vital-label">Wounds</span><strong><%= @character.trait_set&.current_wounds || "—" %><small> / <%= @character.trait_set&.max_wounds || "—" %></small></strong><span class="vital-foot">Hit Dice <%= @character.trait_set&.current_hit_dice || "—" %>/<%= @character.trait_set&.max_hit_dice || "—" %></span></div>
  </section>

  <% resource_tracks = @character.trait_set&.resource_tracks.to_a %>
  <% if resource_tracks.any? %>
    <section class="panel resource-summary-panel">
      <div class="panel-heading compact"><div><p class="eyebrow">Game resources</p><h2>Ready to spend</h2></div><span class="mini-label">Tracked with the sheet</span></div>
      <div class="resource-summary-grid">
        <% resource_tracks.each do |track| %>
          <div class="resource-summary-item">
            <span><%= track.fetch("name") %></span>
            <strong><%= track.fetch("current") %><small><%= " / #{track['max']}" if track["max"].present? %></small></strong>
            <em><%= track["reset"] %></em>
            <% if track["source_ref"].present? %>
              <details class="resource-rule-note">
                <summary>Rule · <%= track.fetch("source_ref") %></summary>
                <p><%= track.fetch("source_quote") %></p>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "progression_panel", character: @character %>

  <div class="sheet-grid">
    <div class="sheet-main-column">
      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Abilities</p><h2>Stats & skills</h2></div><span class="mini-label">Rules-derived</span></div>
        <div class="sheet-stat-grid">
          <% Character::STAT_NAMES.each do |stat| %>
            <div class="sheet-stat"><span><%= stat_display_name(stat) %></span><strong><%= signed_value(@character.stat_value(stat)) %></strong><small><%= @character.character_class&.key_stats&.include?(stat) ? "Key" : "Secondary" %></small></div>
          <% end %>
        </div>
        <div class="sheet-skill-grid">
          <% Character::SKILL_NAMES.each do |skill| %>
            <div class="sheet-skill"><span><%= skill_display_name(skill) %></span><strong><%= signed_value(@character.skill_value(skill)) %></strong></div>
          <% end %>
        </div>
      </section>

      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Origin</p><h2>Rules context</h2></div><span class="rules-context"><span class="context-dot"></span><%= @character.rules_context_label %></span></div>
        <div class="origin-grid">
          <div class="origin-card"><span class="origin-label">Class</span><strong><%= [ @character.character_class&.name || @character.nimble_class || "Not chosen", @character.subclass_name ].compact.join(" · ") %></strong><p><%= @character.character_class ? "#{@character.character_class.key_stats.map { |stat| stat_display_name(stat) }.join(' + ')} Key Stats · #{@character.character_class.hit_die} · Saves #{stat_display_name(@character.character_class.save_bonus_stat)}+ / #{stat_display_name(@character.character_class.save_penalty_stat)}−" : "Choose a rules class to unlock derived values." %></p></div>
          <div class="origin-card"><span class="origin-label">Ancestry</span><strong><%= @character.ancestry&.name || @character.race || "Not chosen" %></strong><p><%= @character.ancestry&.trait_summary || "Ancestry traits will appear here." %></p></div>
          <div class="origin-card"><span class="origin-label">Background</span><strong><%= @character.background&.name || @character.legacy_background_text || "Not chosen" %></strong><p><%= @character.background&.description || "Background story notes are kept with the sheet." %></p></div>
          <div class="origin-card"><span class="origin-label">Starting gear</span><strong><%= @character.starting_equipment.presence || "Not recorded" %></strong><p>Class starting equipment; inventory can be edited during play.</p></div>
          <div class="origin-card"><span class="origin-label">Proficiencies</span><strong><%= @character.character_class&.armor_proficiencies&.join(", ").presence || "None" %></strong><p>Armor · <%= @character.character_class&.weapon_proficiencies&.join(", ").presence || "No weapon category" %></p></div>
          <div class="origin-card"><span class="origin-label">Languages</span><strong><%= @character.languages.presence || "Common" %></strong><p>Common plus INT and ancestry grants.</p></div>
        </div>
      </section>

      <section class="panel sheet-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Magic</p><h2>Spells</h2></div><%= link_to "Browse reference", spells_path, class: "text-link" %></div>
        <div class="spell-chips">
          <% @character.spells.order(:tier, :name).each do |spell| %><%= link_to spell.name, spell, class: "spell-chip #{color_from_spell_school(spell.school)}" %><% end %>
          <% if @character.spells.empty? %><span class="muted">No spells on this sheet yet.</span><% end %>
        </div>
      </section>
      <%= render "inventory_items", character: @character, editable: true %>
    </div>

    <aside class="sheet-side-column">
      <section class="panel tracker-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">At the table</p><h2>Track the moment</h2></div><span class="mini-label">Autosaved as a revision</span></div>
        <%= form_with model: @character, url: tracker_character_path(@character), method: :patch, class: "tracker-form" do |tracker_form| %>
          <%= tracker_form.fields_for :trait_set do |trait_fields| %>
            <div class="tracker-number-grid">
              <label><span>HP</span><%= trait_fields.number_field :current_hp, min: 0, max: @character.trait_set&.max_hp %></label>
              <label><span>Temp HP</span><%= trait_fields.number_field :temp_hp, min: 0 %></label>
              <label><span>Wounds</span><%= trait_fields.number_field :current_wounds, min: 0, max: @character.trait_set&.max_wounds %></label>
              <label><span>Actions</span><%= trait_fields.number_field :current_actions, min: 0, max: @character.trait_set&.max_actions %></label>
              <label><span>Hit Dice</span><%= trait_fields.number_field :current_hit_dice, min: 0, max: @character.trait_set&.max_hit_dice %></label>
              <% resource_tracks = @character.trait_set&.resource_tracks.to_a %>
              <% if resource_tracks.any? %>
                <% resource_tracks.each do |track| %>
                  <label>
                    <span><%= track.fetch("name") %><small><%= [ (" / #{track['max']}" if track["max"].present?), track["reset"] ].compact.join(" · ") %></small></span>
                    <%= hidden_field_tag "character[trait_set_attributes][resource_tracks][][key]", track.fetch("key") %>
                    <%= number_field_tag "character[trait_set_attributes][resource_tracks][][current]", track["current"], min: 0, max: track["max"] %>
                  </label>
                <% end %>
              <% else %>
                <label><span>Mana</span><%= trait_fields.number_field :current_mana, min: 0, max: @character.trait_set&.max_mana %></label>
                <label><span><%= @character.trait_set&.resource_name.presence || "Resource" %></span><%= trait_fields.number_field :current_resource, min: 0, max: @character.trait_set&.max_resource %></label>
              <% end %>
            </div>
          <% end %>
          <div class="field"><%= tracker_form.label :conditions, "Conditions" %><%= tracker_form.text_field :conditions, placeholder: "e.g. Smoldering, Inspired" %></div>
          <div class="field"><%= tracker_form.label :inventory, "Inventory / notes" %><%= tracker_form.text_area :inventory, rows: 3, placeholder: "What is in reach right now?" %></div>
          <div class="field"><%= tracker_form.label :game_notes, "Session notes" %><%= tracker_form.text_area :game_notes, rows: 3, placeholder: "Remember this for next time…" %></div>
          <%= tracker_form.submit "Save game state", class: "button button-primary button-full" %>
        <% end %>
        <div class="safe-rest-action">
          <p class="eyebrow">Safe Rest</p>
          <p>At a GM-designated safe location: recover all HP and Hit Dice, heal 1 Wound, clear Temp HP, and refresh tracked rest resources.</p>
          <span class="field-hint">Core Rules 2.0.1, pp. 9, 16 · encounter-reset resources return to their starting state.</span>
          <%= button_to "Complete Safe Rest", safe_rest_character_path(@character), method: :patch, class: "button button-secondary button-full" %>
        </div>
        <div class="field-rest-action">
          <p class="eyebrow">Field Rest · <%= @character.trait_set&.hit_die || "Hit Die" %></p>
          <p>Catch Breath takes at least 10 minutes and spends one Hit Die per roll, so you can decide whether to continue. Make Camp takes 8 hours with food and sleep and uses each die’s maximum. STR is added automatically.</p>
          <span class="field-hint">Core Rules 2.0.1, p. 16 · Hit Dice available: <%= @character.trait_set&.current_hit_dice || 0 %></span>
          <% if (@character.trait_set&.current_hit_dice || 0).to_i.positive? %>
            <%= form_with url: field_rest_character_path(@character), method: :patch, scope: :field_rest, class: "field-rest-form" do |rest_form| %>
              <%= rest_form.hidden_field :mode, value: "catch_breath" %>
              <%= rest_form.hidden_field :hit_dice, value: 1 %>
              <div class="field-rest-fields">
                <div class="field"><%= rest_form.label :die_rolls, "Single Hit Die roll (d#{@character.hit_die_sides})", for: "catch_breath_die_rolls" %><%= rest_form.number_field :die_rolls, id: "catch_breath_die_rolls", min: 1, max: @character.hit_die_sides, step: 1 %></div>
              </div>
              <%= rest_form.submit "Catch Breath · 10 min", class: "button button-secondary button-full" %>
            <% end %>
            <%= form_with url: field_rest_character_path(@character), method: :patch, scope: :field_rest, class: "field-rest-form" do |rest_form| %>
              <%= rest_form.hidden_field :mode, value: "make_camp" %>
              <div class="field"><%= rest_form.label :hit_dice, "Hit Dice to spend", for: "make_camp_hit_dice" %><%= rest_form.number_field :hit_dice, id: "make_camp_hit_dice", min: 1, max: @character.trait_set.current_hit_dice, value: 1 %></div>
              <%= rest_form.submit "Make Camp · 8 hours", class: "button button-secondary button-full" %>
            <% end %>
          <% else %>
            <p class="field-hint">No Hit Dice available to spend.</p>
          <% end %>
        </div>
      </section>

      <section class="panel timeline-panel">
        <div class="panel-heading compact"><div><p class="eyebrow">Continuity</p><h2>Recent changes</h2></div><%= link_to "View all", history_character_path(@character), class: "text-link" %></div>
        <div class="timeline">
          <% @revisions.each do |revision| %>
            <div class="timeline-item"><span class="<%= revision_event_class(revision.event_type) %>"></span><div><strong><%= revision.event_label %></strong><p><%= revision.summary %></p><time><%= time_ago_in_words(revision.created_at) %> ago</time></div></div>
          <% end %>
          <% if @revisions.empty? %><p class="muted">Your first save will appear here.</p><% end %>
        </div>
      </section>
    </aside>
  </div>

  <section class="panel sharing-panel">
    <div class="panel-heading compact"><div><p class="eyebrow">Share the sheet</p><h2>Let your table see it</h2><p class="panel-subtitle">Character ownership stays here. Shared views are read-only.</p></div><%= link_to "Campaigns", campaigns_path, class: "text-link" %></div>
    <% if @campaigns.any? %>
      <%= form_with url: character_shares_path(@character), class: "share-form" do |share_form| %>
        <%= share_form.collection_select :campaign_id, @campaigns, :id, :name, { include_blank: "Choose a campaign" } %>
        <%= share_form.submit "Share read-only sheet", class: "button button-secondary" %>
      <% end %>
    <% else %>
      <div class="sharing-empty"><p>Create a campaign workspace first, then share this sheet with a read-only link.</p><%= link_to "Create a campaign", new_campaign_path, class: "button button-secondary" %></div>
    <% end %>
    <% if @character.character_shares.any? %>
      <div class="share-list"><% @character.character_shares.includes(:campaign).each do |share| %><div><span><%= share.campaign.name %></span><%= link_to "Open shared view", shared_character_path(share.share_token), class: "text-link" %></div><% end %></div>
    <% end %>
  </section>

  <div class="page-footer-actions"><%= button_to "Delete character", @character, method: :delete, class: "text-link text-link-danger", data: { turbo_confirm: "Delete this character and its revision history?" } %></div>
</div>
