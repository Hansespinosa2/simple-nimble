<% ancestry_rule = Rules::NimbleCatalog.ancestry_derived_rule_for(character.ancestry&.name) %>
<% feature_note = Rules::NimbleCatalog.ancestry_feature_note_for(character.ancestry&.name) %>
<% if feature_note["manual_effect"].present? %>
  <p class="field-hint ancestry-rules-note"><% if ancestry_rule.fetch("hit_die_size_steps", 0).to_i.positive? %><strong>Current Hit Die:</strong> <%= character.trait_set&.hit_die || character.hit_die_for %>. <% end %><strong>At-table reminder (not automatically resolved):</strong> <%= feature_note.fetch("manual_effect") %> (<%= feature_note.fetch("source_ref") %>)</p>
<% end %>
