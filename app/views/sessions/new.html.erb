<% content_for :title, "Sign in" %>

<div class="page-shell narrow-shell session-shell">
  <section class="session-card panel">
    <div class="session-mark">✦</div>
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in to Nimble.</h1>
    <p class="hero-subtitle">Your characters and campaign access are private to your account.</p>
    <% if flash[:alert].present? %><div class="alert-card alert-card-danger" role="alert"><span class="alert-icon">!</span><%= flash[:alert] %></div><% end %>
    <%= form_with url: session_path, class: "session-form" do |form| %>
      <div class="field"><%= form.label :email %><%= form.email_field :email, placeholder: "you@example.com", autocomplete: "email", autofocus: true, required: true %></div>
      <div class="field"><%= form.label :password %><%= form.password_field :password, autocomplete: "current-password", required: true %></div>
      <%= form.submit "Sign in", class: "button button-primary button-full" %>
    <% end %>
    <p class="session-footnote">New to Nimble? <%= link_to "Create an account", new_account_path %>.</p>
  </section>
</div>
