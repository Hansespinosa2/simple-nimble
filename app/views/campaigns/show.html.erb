<% content_for :title, @campaign.name %>

<div class="page-shell dashboard-shell">
  <% if notice.present? %><div class="alert-card alert-card-success"><span class="alert-icon">✓</span><span><%= notice %></span></div><% end %>
  <div class="subpage-header"><div><%= link_to "← Campaigns", campaigns_path, class: "text-link" %><p class="eyebrow">Shared table</p><h1><%= @campaign.name %></h1><p class="hero-subtitle"><%= @campaign.description.presence || "A read-only character workspace." %></p></div><span class="badge badge-playable"><%= @campaign.owner_account == current_account ? "You own this campaign" : "Campaign member" %></span></div>
  <section class="campaign-invite panel"><div><p class="eyebrow">Invite code</p><h2><%= @campaign.invite_code %></h2><p class="muted">Give this code to a player so they can join the campaign workspace.</p></div><%= form_with url: join_campaign_path(@campaign), method: :post, class: "join-form" do |form| %><%= form.text_field :invite_code, placeholder: "Enter code" %><%= form.submit "Join", class: "button button-secondary" %><% end %></section>
  <section class="campaign-sheet-list"><div class="list-toolbar"><div><p class="eyebrow">Shared characters</p><h2><%= pluralize(@shares.size, "sheet") %></h2></div></div>
    <% if @shares.any? %><div class="character-grid"><% @shares.each do |share| %><article class="character-card"><div class="character-card-topline"><span class="badge badge-playable">Read-only</span><span class="card-level">LV <%= share.character.level || "—" %></span></div><div class="character-identity"><div class="avatar avatar-<%= share.character.id.to_i % 5 %>"><%= (share.character.name.presence || "?")[0, 2].upcase %></div><div><h3><%= share.character.name.presence || "Untitled hero" %></h3><p><%= [ share.character.character_class&.name || share.character.nimble_class, share.character.ancestry&.name || share.character.race ].compact.join(" · ") %></p></div></div><p class="muted campaign-share-owner">Shared by <%= share.created_by_account&.display_name || "player" %></p><%= link_to "Open sheet", shared_character_path(share.share_token), class: "button button-secondary button-full" %></article><% end %></div><% else %><div class="empty-state"><div class="empty-state-mark">◌</div><h2>No sheets shared yet.</h2><p>Players can share their read-only character sheets from the sheet's Share section.</p></div><% end %>
  </section>
</div>
