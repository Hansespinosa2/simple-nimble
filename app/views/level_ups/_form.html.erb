<%= form_with model: [ character, level_up ], class: "level-up-form" do |form| %>
  <% if level_up.errors.any? %>
    <% planner_explanations = @planner&.explanations.to_a %>
    <% planner_messages = planner_explanations.map { |explanation| explanation.fetch(:message) } %>
    <% unmatched_errors = level_up.errors.full_messages.reject { |message| planner_messages.include?(message) } %>
    <section class="alert-card alert-card-danger">
      <div class="alert-icon">!</div>
      <div>
        <h2>Finish the level-up choices</h2>
        <ul class="blocked-choice-list">
          <% planner_explanations.each do |explanation| %>
            <li class="blocked-choice">
              <strong><%= explanation.fetch(:message) %></strong>
              <small><%= explanation.fetch(:source_ref) %> · “<%= explanation.fetch(:quote) %>”</small>
              <% if explanation[:rule_note].present? %><small class="source-note">Rules note: <%= explanation.fetch(:rule_note) %></small><% end %>
            </li>
          <% end %>
          <% unmatched_errors.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="level-up-choice-grid">
    <div class="panel panel-featured">
      <p class="eyebrow">Required</p>
      <h2>Choose your improvement</h2>
      <p class="panel-subtitle">Every level grants <%= @planner.skill_points_per_level_description %>. The level-up stays a preview until you apply it.</p>
      <small class="source-note skill-rule-note">Rules basis: <%= @planner.skill_point_progression_note %> (<%= @planner.skill_point_progression_source_ref %>).</small>
      <div class="field">
        <%= form.label :skill_name, "Skill point" %>
        <%= form.select :skill_name, @planner.skill_options.map { |skill| [ skill_display_name(skill), skill ] }, { include_blank: "Choose a skill" }, class: "choice-select" %>
        <span class="field-hint">Choose any skill below +<%= @planner.max_skill_value %>. The governing stat is already included in the preview.</span>
      </div>

      <% if @planner.subclass_selection_required? %>
        <div class="field">
          <%= form.label :subclass_name, "Subclass" %>
          <%= form.select :subclass_name, @planner.subclass_options.map { |subclass| [ subclass, subclass ] }, { include_blank: "Choose a subclass" }, class: "choice-select" %>
          <span class="field-hint"><%= @character.character_class.source_reference %> · Choose a subclass at level <%= @planner.subclass_choice_level %>.</span>
          <% if @planner.story_based_subclass_rules.any? %>
            <% story_subclass_names = @planner.story_based_subclass_rules.map { |subclass| subclass.fetch("name") } %>
            <% story_subclass_rule = @planner.story_based_subclass_rules.first %>
            <span class="field-hint">Story-based options: <%= story_subclass_names.join(", ") %>. <%= story_subclass_rule.fetch("source_quote") %> (<%= story_subclass_rule.fetch("source_ref") %>)</span>
          <% end %>
        </div>
      <% end %>

      <% @planner.feature_choice_pools.each do |pool| %>
        <% field_name = "level_up[feature_choices][#{pool.fetch('name')}][]" %>
        <% selected_options = pool.fetch("selected") %>
        <% already_chosen = @character.recorded_feature_choices.fetch(pool.fetch("name"), []) %>
        <% multiple_choices = pool.fetch("count").to_i > 1 %>
        <% option_descriptions = pool.fetch("option_descriptions", {}) %>
        <% option_labels = pool.fetch("options").map { |option| [ [ option, option_descriptions[option] ].compact.join(" · "), option ] } %>
        <div class="field feature-choice-field">
          <%= label_tag field_name, "#{pool.fetch('name')} · choose #{pool.fetch('count')}" %>
          <%= select_tag field_name, options_for_select(option_labels, selected_options), include_blank: (multiple_choices ? nil : "Choose an option"), multiple: multiple_choices, class: "choice-select" %>
          <span class="field-hint"><%= pool.fetch("source_ref") %> · choose <%= pool.fetch("count") %> option<%= pool.fetch("count").to_i == 1 ? "" : "s" %> from the printed list.</span>
          <% if pool["source_quote"].present? %><span class="field-hint"><%= pool.fetch("source_quote") %></span><% end %>
          <% if already_chosen.any? %>
            <span class="field-hint">Already recorded: <%= already_chosen.join(", ") %>. Choose a different option.</span>
          <% end %>
        </div>
      <% end %>

      <% if @planner.stat_options.include?("intelligence") %>
        <% language_rules = Rules::NimbleCatalog.language_rules %>
        <div class="field feature-choice-field">
          <%= label_tag "level_up[language_choices][]", "New INT language choice" %>
          <%= select_tag "level_up[language_choices][]", options_for_select(@planner.language_choice_options.map { |language| [ language, language ] }, Array(level_up.language_choices)), multiple: true, size: 5, class: "choice-select" %>
          <span class="field-hint">If this level increases INT, choose one new language per positive INT point gained. <%= language_rules.fetch("source_quote") %> (<%= language_rules.fetch("source_ref") %>)</span>
        </div>
      <% end %>

      <% @planner.feature_language_choice_rules.each do |feature_name, rule| %>
        <% field_name = "level_up[feature_language_choices][#{feature_name}][]" %>
        <% selected_languages = level_up.feature_language_choices.to_h.stringify_keys.fetch(feature_name, []) %>
        <div class="field feature-choice-field">
          <%= label_tag field_name, "#{feature_name} · choose #{rule.fetch('count')} languages" %>
          <%= select_tag field_name, options_for_select(@planner.feature_language_choice_options(feature_name).map { |language| [ language, language ] }, selected_languages), multiple: true, size: [ rule.fetch("count").to_i + 1, 5 ].max, class: "choice-select" %>
          <span class="field-hint">Only complete this if you choose #{feature_name} in its feature pool. <%= rule.fetch("source_quote") %> (<%= rule.fetch("source_ref") %>)</span>
        </div>
      <% end %>

      <% @planner.spell_choice_pools.each do |pool| %>
        <% field_name = "level_up[spell_choices][#{pool.fetch('name')}][]" %>
        <% selected_options = pool.fetch("selected") %>
        <% already_chosen = @character.recorded_spell_choices.fetch(pool.fetch("name"), []) %>
        <% multiple_choices = pool.fetch("count").to_i > 1 %>
        <div class="field feature-choice-field spell-choice-field">
          <%= label_tag field_name, "#{pool.fetch('name')} · choose #{pool.fetch('count')}" %>
          <%= select_tag field_name, options_for_select(pool.fetch("options").map { |option| [ option, option ] }, selected_options), include_blank: (multiple_choices ? nil : "Choose an option"), multiple: multiple_choices, class: "choice-select" %>
          <% source_refs = [ pool.fetch("source_ref"), pool["story_source_ref"] ].compact.uniq %>
          <span class="field-hint"><%= pool.fetch("source_quote", "Choose from the options listed for this feature.") %> (<%= source_refs.join(" · ") %>)</span>
          <% if already_chosen.any? %>
            <span class="field-hint">Already recorded: <%= already_chosen.join(", ") %>. Choose a different spell or school.</span>
          <% end %>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :skill_from, "Optional moved point" %>
        <%= form.select :skill_from, Character::SKILL_NAMES.map { |skill| [ skill_display_name(skill), skill ] }, { include_blank: "Do not move a point" }, class: "choice-select" %>
        <span class="field-hint">Move <%= @planner.skill_point_transfers_per_level_description %> from this skill to the skill above; it cannot become negative.</span>
      </div>

      <div class="field">
        <%= form.label :hit_die_roll_one, "Hit Die roll 1 (d#{@planner.hit_die_size})" %>
        <%= form.number_field :hit_die_roll_one, min: 1, max: @planner.hit_die_size, class: "choice-input" %>
      </div>
      <div class="field">
        <%= form.label :hit_die_roll_two, "Hit Die roll 2 (d#{@planner.hit_die_size})" %>
        <%= form.number_field :hit_die_roll_two, min: 1, max: @planner.hit_die_size, class: "choice-input" %>
        <span class="field-hint">The higher result increases max HP. The app rolls both for a convenient starting preview; replace them with your table rolls if needed.</span>
      </div>

      <% if @planner.stat_increase_type.present? %>
        <div class="field">
          <%= form.label :stat_name, "Stat increase · #{@planner.stat_increase_label}" %>
          <%= form.select :stat_name, @planner.stat_options.map { |stat| [ stat_display_name(stat), stat ] }, { include_blank: "Choose a stat" }, class: "choice-select" %>
          <span class="field-hint"><%= @planner.stat_increase_choice_description %> At level <%= @planner.target_level %>.</span>
        </div>
        <% if @planner.stat_increase_choice_count > 1 %>
          <div class="field">
            <%= form.label :second_stat_name, "Second stat increase" %>
            <%= form.select :second_stat_name, @planner.stat_options.map { |stat| [ stat_display_name(stat), stat ] }, { include_blank: "Choose a second stat" }, class: "choice-select" %>
            <span class="field-hint">The selected stats must be different.</span>
          </div>
        <% end %>
      <% else %>
        <div class="rules-callout"><span class="callout-icon">i</span><span>No stat increase is scheduled at level <%= @planner.target_level %>. Save that choice for the next milestone.</span></div>
      <% end %>

      <div class="field">
        <%= form.label :notes, "Level-up notes" %>
        <%= form.text_area :notes, rows: 4, placeholder: "What changed in the story?", class: "choice-textarea" %>
      </div>
    </div>

    <div class="panel preview-panel">
      <div class="panel-heading compact">
        <div>
          <p class="eyebrow">Live preview</p>
          <h2>Level <%= @planner.target_level %></h2>
        </div>
        <span class="preview-pulse"></span>
      </div>
      <% preview = @planner.preview %>
      <div class="level-preview-stats">
        <% Character::STAT_NAMES.each do |stat| %>
          <div><span><%= stat_display_name(stat) %></span><strong><%= signed_value(preview.fetch("stats").fetch(stat)) %></strong></div>
        <% end %>
      </div>
      <div class="preview-list">
        <div><span>Max HP</span><strong><%= preview.fetch("traits").fetch("max_hp") %> <small>+<%= preview.fetch("hp_gain") %> (rolls <%= preview.fetch("hit_die_rolls").join(" / ") %>)</small></strong></div>
        <div><span>Hit Dice</span><strong><%= preview.fetch("traits").fetch("current_hit_dice") %> / <%= preview.fetch("traits").fetch("max_hit_dice") %></strong></div>
        <div><span>Languages</span><strong><%= preview.fetch("languages").join(", ") %></strong></div>
        <div><span>Armor</span><strong><%= preview.fetch("traits").fetch("armor") %></strong></div>
        <div><span>Initiative</span><strong><%= signed_value(preview.fetch("traits").fetch("initiative")) %></strong></div>
        <div><span>Spell tier</span><strong><%= preview.fetch("spell_tier").positive? ? "Tier #{preview.fetch('spell_tier')}" : "None" %></strong></div>
        <% if preview.fetch("subclass").present? %><div><span>Subclass</span><strong><%= preview.fetch("subclass") %></strong></div><% end %>
      </div>
      <% progression = preview.fetch("progression") %>
      <% if progression.fetch("features").any? || progression.fetch("subclass_features").any? %>
        <div class="progression-preview">
          <p class="eyebrow">New at level <%= @planner.target_level %></p>
          <h3>Class progression</h3>
          <ul class="feature-list">
            <% progression.fetch("features").each do |feature| %><li><span>✦</span><%= feature %></li><% end %>
            <% progression.fetch("subclass_features").each do |feature| %><li><span>✦</span><%= feature %> <small>(<%= progression.fetch("subclass_name") %>)</small></li><% end %>
            <% progression.fetch("feature_choices").each do |pool| %>
              <li><span>✦</span><%= pool.fetch("name") %>: <small><%= pool.fetch("selected").any? ? pool.fetch("selected").join(", ") : "choice required" %></small></li>
            <% end %>
            <% progression.fetch("spell_choices").each do |pool| %>
              <li><span>✦</span><%= pool.fetch("name") %>: <small><%= pool.fetch("selected").any? ? pool.fetch("selected").join(", ") : "choice required" %></small></li>
            <% end %>
          </ul>
          <small class="source-note"><%= progression.fetch("source_ref") %> · progression table</small>
        </div>
      <% end %>
      <div class="explanation-stack">
        <% preview.fetch("explanations").each do |explanation| %>
          <div class="explanation explanation-<%= explanation.fetch(:type) %>">
            <span class="explanation-marker"><%= explanation.fetch(:type) == "auto_applied" ? "✦" : "✓" %></span>
            <div><strong><%= explanation.fetch(:message) %></strong><small><%= explanation.fetch(:source_ref) %> · “<%= explanation.fetch(:quote) %>”</small></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="level-up-actions">
    <%= form.submit "Save draft", class: "button button-secondary" %>
    <%= form.submit "Apply level-up", name: "finalize", value: "1", class: "button button-primary" %>
  </div>
<% end %>
