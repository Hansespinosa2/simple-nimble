<% content_for :title, "Level up #{@character.name.presence || 'character'}" %>

<div class="page-shell">
  <div class="subpage-header">
    <div>
      <%= link_to "← #{@character.name.presence || 'Character'}", @character, class: "text-link" %>
      <p class="eyebrow">Explicit transition · <%= @character.rules_context_label %></p>
      <h1>Level up to <%= @planner.target_level %></h1>
      <p class="muted">Nothing changes until you apply the completed transition.</p>
    </div>
    <span class="badge badge-level-up">Preview mode</span>
  </div>
  <%= render "form", character: @character, level_up: @level_up %>
</div>
